<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
<meta charset="UTF-8">
<title>Dive Sites - Bhaccasyoniztas Beach Resort Website Template</title>
<link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
<div id="background">
<div id="page">
{{> header }}
<div id="contents">
<div class="box">
<div>
<div class="body">
<h1>Travel</h1>
<ul id="sites">
{{#each trips}}
<li>
<img src="images/{{this.image}}" alt="{{this.name}}">
<h2>{{this.name}}</h2>
<p><strong>{{this.resort}}</strong> | {{this.length}} | ${{this.perPerson}} per person</p>
{{{this.description}}}
</li>
{{/each}}
</ul>
</div>
</div>
</div>
</div>
</div>
{{> footer }}
</div>
</body>
</html>
